msgstr "No puedes cerrar esta caja."

#: sales/services.py:86
msgid "This cash session is already closed."
msgstr "Esta caja ya está cerrada."

#: sales/services.py:89
msgid "Enter the counted cash."
msgstr "Captura el efectivo contado."

#: sales/services.py:103
msgid "Explain the difference between the counted and the expected cash."
msgstr "Explica la diferencia entre el efectivo contado y el esperado."

#: sales/services.py:156 sales/services.py:313
msgid "You cannot charge sales."
msgstr "No puedes cobrar ventas."

#: sales/services.py:176
msgid "A drop-off sale needs a customer."
msgstr "Una venta por encargo necesita un cliente."

#: sales/services.py:179
msgid "The customer belongs to another branch."
msgstr "El cliente pertenece a otra sucursal."

#: sales/services.py:182
msgid "Enter when the order will be ready."
msgstr "Indica cuándo estará listo el encargo."

#: sales/services.py:185
msgid "The promised date cannot be in the past."
msgstr "La fecha promesa no puede estar en el pasado."

#: sales/services.py:188
msgid "Add at least one service or product."
msgstr "Agrega al menos un servicio o producto."

#: sales/services.py:245
msgid "Open the cash session first."
msgstr "Primero abre la caja."

#: sales/services.py:260
msgid "The sale belongs to another branch."
msgstr "La venta es de otra sucursal."

#: sales/services.py:265
msgid "You cannot cancel sales."
msgstr "No puedes cancelar ventas."

#: sales/services.py:279
msgid "This sale is already cancelled."
msgstr "Esta venta ya está cancelada."

#: sales/services.py:284
msgid "A delivered drop-off order cannot be cancelled."
msgstr "No se puede cancelar un encargo ya entregado."

#: sales/services.py:289
msgid "Explain why the sale is cancelled."
msgstr "Explica por qué se cancela la venta."

#: sales/services.py:325
msgid "A cancelled sale cannot be paid."
msgstr "No se puede pagar una venta cancelada."

#: sales/services.py:338
msgid "The amount must be greater than zero."
msgstr "El monto debe ser mayor que cero."

#: sales/services.py:341
#, python-format
msgid "The amount is more than the balance of %(balance)s."
msgstr "El monto es mayor que el saldo de %(balance)s."

#: sales/services.py:381
msgid "You cannot apply discounts."
msgstr "No puedes aplicar descuentos."

#: sales/services.py:392
msgid "Discounts are applied before the first payment."
msgstr "Los descuentos se aplican antes del primer pago."

#: sales/services.py:397
msgid "This discount does not apply to this sale."
msgstr "Este descuento no aplica a esta venta."

#: sales/services.py:402
msgid "This discount does not reduce the sale."
msgstr "Este descuento no reduce la venta."

#: sales/services.py:457 sales/services.py:481
msgid "You cannot manage drop-off orders."
msgstr "No puedes gestionar encargos."

#: sales/services.py:472
msgid "This order cannot move forward; deliver it instead."
msgstr "Este encargo ya no avanza; entrégalo."

#: sales/services.py:489
msgid "Only a ready order can be delivered."
msgstr "Solo se puede entregar un encargo listo."

#: sales/services.py:492
msgid "You cannot deliver an order with a pending balance."
msgstr "No puedes entregar un encargo con saldo pendiente."

#: sales/services.py:510
msgid "The sale of this order is cancelled."
msgstr "La venta de este encargo está cancelada."

#: sales/services.py:536
#, python-format
msgid "Not enough %(product)s in stock: %(stock)s left."
msgstr "No hay suficiente %(product)s: quedan %(stock)s."

#: sales/services.py:576
msgid "The quantity must be greater than zero."
msgstr "La cantidad debe ser mayor que cero."

#: sales/services.py:579
msgid "Each line is either a service or a product."
msgstr "Cada línea es un servicio o un producto."

#: sales/services.py:583
#, python-format
msgid "%(service)s is not active."
msgstr "%(service)s no está activo."

#: sales/services.py:587
msgid "Services are sold in whole units."
msgstr "Los servicios se venden en unidades completas."

#: sales/services.py:593
#, python-format
msgid "%(service)s has no price for this mode."
msgstr "%(service)s no tiene precio para esta modalidad."

#: sales/services.py:599
#, python-format
msgid "%(product)s is not for sale."
msgstr "%(product)s no está a la venta."
