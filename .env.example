# Copy to .env and adjust. The .env file is NOT committed to git.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_TIME_ZONE=America/Mexico_City

# Database (must match POSTGRES_*)
POSTGRES_DB=laundry
POSTGRES_USER=laundry
POSTGRES_PASSWORD=laundry
DATABASE_URL=postgres://laundry:laundry@db:5432/laundry

# JWT
JWT_ACCESS_MINUTES=30
JWT_REFRESH_HOURS=12

# API pagination: default page size and the most the POS may ask for (?page_size=)
API_PAGE_SIZE=25
API_MAX_PAGE_SIZE=100
